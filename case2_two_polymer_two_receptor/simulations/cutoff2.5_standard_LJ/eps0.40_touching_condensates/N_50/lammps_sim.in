units           lj
boundary        p p f
atom_style      bond

log             log.polymer_wall.txt

pair_style      lj/cut 4.0
pair_modify     shift yes

read_data       initial.xyz

bond_style      fene
special_bonds   fene

bond_coeff      1 10.0 2.0 1.0 1.0

group polymerA type 1
group polymerB type 2
group receptorC type 3
group receptorD type 4


# A-A
pair_coeff 1 1 0.5 1.0 2.5

# B-B
pair_coeff 2 2 0.5 1.0 2.5

# A-B
pair_coeff 1 2 0.1 1.0 2.5

# B-D
pair_coeff 2 4 50.0 1.0 4.0

# A-C
pair_coeff 1 3 50.0 1.0 4.0

# A-D
pair_coeff 1 4 50.0 1.0 1.1225

# B-C
pair_coeff 2 3 50.0 1.0 1.1225

pair_coeff 3 3 1.0 1.0 1.1225
pair_coeff 4 4 1.0 1.0 1.1225
pair_coeff 3 4 1.0 1.0 1.1225

neighbor        0.5 bin

minimize        1.0e-4 1.0e-6 100 1000

fix 1 all wall/lj126 zlo -32 0.1 1.0 1.1225 zhi 32 0.1 1.0 1.1225 

fix 3 all nve/limit 0.01
fix 4 all langevin 1 1 1.0 90428
fix bias_all all bias_center 1.0 15

thermo_style    custom step temp pe ke ebond
thermo_modify   flush yes
thermo          10000

timestep        0.005
run             10000

unfix 3
fix 3 all nve

dump 1 all custom 1000 file_trajectory.bin id type x y z xu yu zu vx vy vz

restart 10000 prod.restart1 prod.restart2
run 10000

write_data      data_final.xyz
write_restart   restart.polymer_ring

print "ALL done"

